# ─────────────────────────────────────────────────────────────────────────────
# ServerForge — environment configuration
# Copy to `.env` and adjust. `npm run bootstrap` does this for you and
# generates the secrets automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Branding ────────────────────────────────────────────────────────────────
# Change these three lines to rebrand the entire product (UI, emails, docs
# header, page titles, API `X-Powered-By`). Nothing else hardcodes the name.
BRAND_NAME="ServerForge"
BRAND_TAGLINE="Launch a game server in minutes, not hours."
BRAND_ACCENT="#f97316"
NEXT_PUBLIC_BRAND_NAME="ServerForge"
NEXT_PUBLIC_BRAND_TAGLINE="Launch a game server in minutes, not hours."
NEXT_PUBLIC_BRAND_ACCENT="#f97316"

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=serverforge
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=serverforge
POSTGRES_PORT=5432
DATABASE_URL="postgresql://serverforge:change-me-in-production@localhost:5432/serverforge?schema=public"

# ── Redis (queues, pub/sub, rate limits, console ring buffer) ───────────────
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ── API service ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
# Public origin of the API as reachable by the browser.
NEXT_PUBLIC_API_URL="http://localhost:8080"
# Comma separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000"

# 64-char hex. Signs session cookies + API tokens. `npm run bootstrap` fills it.
SESSION_SECRET=""
# 64-char hex. AES-256-GCM key for secrets at rest (e.g. CurseForge API keys).
ENCRYPTION_KEY=""

# Session lifetime in seconds (default 7 days).
SESSION_TTL=604800

# ── Web app ─────────────────────────────────────────────────────────────────
WEB_PORT=3000

# The address players type into their game to join. Detected automatically
# from your network interfaces when left blank; set it to a domain name if
# you have one. "localhost" only ever works on this machine.
PUBLIC_HOST=""

# ── Host paths ──────────────────────────────────────────────────────────────
# Where per-server game data lives on the host. Must be an absolute path.
DATA_ROOT="./data/servers"
# Where backup archives are written.
BACKUP_ROOT="./data/backups"
# Where downloaded jars / modpacks are cached between installs.
CACHE_ROOT="./data/cache"
# Absolute host paths mounted into the persistent API container. Bootstrap
# fills these from DATA_ROOT/BACKUP_ROOT and makes them absolute.
#
# The Docker stack requires them: the panel hands HOST_DATA_ROOT to the Docker
# daemon when it creates game containers, so it has to name the same directory
# the API container has mounted. Relative values do not work — Compose and the
# API resolve them against different directories, and Docker then creates the
# wrong path, empty, with no error until the game server cannot find its jar.
HOST_DATA_ROOT=""
HOST_BACKUP_ROOT=""

# Session cookie Secure flag for the API. Use "false" for plain-HTTP LAN access
# (the Docker stack default). Set "true" behind a TLS reverse proxy.
COOKIE_SECURE="false"

# ── Docker runtime ──────────────────────────────────────────────────────────
# Path (or Windows named pipe) the API uses to talk to the Docker daemon.
# Defaults: Linux/macOS /var/run/docker.sock (or ~/.docker/run/docker.sock);
# Windows //./pipe/docker_engine. Inside the full Docker stack the compose file
# mounts the Linux VM socket, so leave this as the Linux path there.
# Bootstrap rewrites the Windows/macOS host default when needed.
DOCKER_SOCKET="/var/run/docker.sock"
# Docker network that game containers join.
DOCKER_NETWORK="serverforge_games"
# Default port range handed out by the allocation manager.
PORT_RANGE_START=25500
PORT_RANGE_END=25999

# ── Automatic port forwarding (UPnP) ────────────────────────────────────────
# Asks your router to forward a server's *game* port when it starts, and to
# remove the forward when it stops. Only the port players connect to is ever
# forwarded — never rcon or query.
#
# Off by default. Turning it on exposes a game server to the internet, which is
# a decision to make deliberately rather than inherit: use a whitelist, and see
# docs/security.md. Note also that UPnP lets *any* device on your LAN open
# ports, which is why plenty of people leave it off at the router.
UPNP_ENABLED="false"
# Optional. Skips SSDP discovery, which is multicast and cannot cross Docker's
# bridge network — so a containerised API needs this set, while `npm run dev`
# on the host finds the router by itself. Use the SOAP control URL from your
# router's device description, or the .xml URL that describes it.
UPNP_CONTROL_URL=""
# 0 = permanent. Mappings are kept alive by periodic re-assertion, not leases.
UPNP_LEASE_SECONDS=0
# The LAN address the router forwards to.
#
# REQUIRED when the API runs in a container, not optional: auto-detection asks
# the kernel which address it would use to reach the router, and inside a
# container that is the container's own 172.17.x.x bridge address. The router
# accepts a mapping to it and the mapping does nothing. The panel refuses to
# forward at all rather than create that, so set this to the *host* machine's
# LAN address. Running on the host, leave it empty unless detection picks the
# wrong interface (VPN, several NICs).
UPNP_INTERNAL_IP=""

# ── Optional third-party integrations ───────────────────────────────────────
# CurseForge API key. Optional — leave blank and users can still import
# modpacks by uploading the .zip manually. Get one at
# https://console.curseforge.com/ (their ToS requires your own key).
CURSEFORGE_API_KEY=""

# Modrinth needs no key, but a descriptive UA is required by their API rules.
MODRINTH_USER_AGENT="serverforge/0.1.0 (self-hosted)"

# ── Optional seed owner (only used by `npm run db:seed`) ────────────────────
# Leave SEED_ADMIN_USERNAME empty so the dashboard shows "Create account" on
# first launch. Set it only when you want a pre-created owner for automation.
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_DISPLAY_NAME=""
