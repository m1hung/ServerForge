{
  "name": "@serverforge/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./settings-schema": {
      "types": "./dist/settings-schema.d.ts",
      "default": "./dist/settings-schema.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../scripts/clean.mjs dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "3.24.1"
  }
}
