# Multi-stage build for the dashboard.
#
# Installation branding and the same-origin API proxy are configured at runtime.

FROM node:22.23.2-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/adapters/package.json packages/adapters/
COPY packages/maintenance/package.json packages/maintenance/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspaces --include-workspace-root --ignore-scripts=false

FROM deps AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=auto
ARG NEXT_PUBLIC_API_PORT=8080
ARG NEXT_PUBLIC_BRAND_NAME=ServerForge
ARG NEXT_PUBLIC_BRAND_TAGLINE="Launch a game server in minutes, not hours."
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_API_PORT=$NEXT_PUBLIC_API_PORT \
    NEXT_PUBLIC_BRAND_NAME=$NEXT_PUBLIC_BRAND_NAME \
    NEXT_PUBLIC_BRAND_TAGLINE=$NEXT_PUBLIC_BRAND_TAGLINE \
    NEXT_TELEMETRY_DISABLED=1

COPY tsconfig.base.json ./
COPY packages/core ./packages/core
COPY apps/web ./apps/web
RUN find . -name '*.tsbuildinfo' -delete \
 && npm run build --workspace @serverforge/core \
 && npm run build --workspace @serverforge/web \
 && mkdir -p apps/web/public

FROM node:22.23.2-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0 PORT=3000
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="ServerForge dashboard" \
      org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.source="https://github.com/m1hung/ServerForge" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

RUN apt-get update && apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/* /usr/local/lib/node_modules /opt/yarn* \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && rm -f /usr/bin/infocmp /usr/bin/mount /usr/bin/umount /usr/bin/nsenter /usr/bin/unshare \
 && find /usr -xdev -type f -perm /6000 -exec chmod a-s '{}' + \
 && useradd --system --uid 1001 --create-home nextjs
COPY --from=build --chown=nextjs:nextjs /app/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nextjs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nextjs:nextjs /app/apps/web/public ./apps/web/public
RUN rm -rf node_modules/typescript apps/web/node_modules/typescript

USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
